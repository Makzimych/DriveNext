<!-- ЛР2. Ресурсы авторизации и регистрации. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><ImageView android:id="@+id/documentsAvatarImage" android:layout_width="@dimen/auth_avatar_size" android:layout_height="@dimen/auth_avatar_size" android:layout_gravity="center_horizontal" android:src="@drawable/auth_avatar" android:contentDescription="@string/auth_avatar"/><com.google.android.material.button.MaterialButton android:id="@+id/documentsAvatar" style="@style/AuthOutlinedButton" android:layout_width="match_parent" android:layout_height="@dimen/auth_button_height" android:layout_marginTop="@dimen/auth_gap" android:text="@string/auth_avatar" /><TextView style="@style/AuthText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/auth_gap" android:text="@string/auth_photo_help"/><com.google.android.material.textfield.TextInputLayout android:id="@+id/documentsLicenseBox" style="@style/AuthInput" android:hint="@string/auth_license" >
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/documentsLicense" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:maxLines="1"  /></com.google.android.material.textfield.TextInputLayout><com.google.android.material.textfield.TextInputLayout android:id="@+id/documentsIssuedBox" style="@style/AuthInput" android:hint="@string/auth_issued" >
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/documentsIssued" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:maxLines="1" android:hint="@string/auth_issue_hint" android:focusable="false" android:clickable="true"/></com.google.android.material.textfield.TextInputLayout><com.google.android.material.button.MaterialButton android:id="@+id/documentsLicensePhoto" style="@style/AuthOutlinedButton" android:layout_width="match_parent" android:layout_height="@dimen/auth_button_height" android:layout_marginTop="@dimen/auth_gap" android:text="@string/auth_license_photo" /><com.google.android.material.button.MaterialButton android:id="@+id/documentsPassportPhoto" style="@style/AuthOutlinedButton" android:layout_width="match_parent" android:layout_height="@dimen/auth_button_height" android:layout_marginTop="@dimen/auth_gap" android:text="@string/auth_passport_photo" /><com.google.android.material.button.MaterialButton android:id="@+id/documentsNext" android:layout_width="match_parent" android:layout_height="@dimen/auth_button_height" android:layout_marginTop="@dimen/auth_gap" android:text="@string/next" /></LinearLayout>

