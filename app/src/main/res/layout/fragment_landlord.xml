<!-- ЛР5. Пять экранов подключения автомобиля по рисункам 53–57 методички. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
 <LinearLayout android:id="@+id/landlordHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <com.google.android.material.button.MaterialButton android:id="@+id/landlordBack" style="@style/Widget.Material3.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp" android:text="‹" android:textSize="28sp" android:contentDescription="@string/landlord_back" />
  <TextView android:id="@+id/landlordTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="20sp" android:textColor="@color/text_primary" android:textStyle="bold" />
 </LinearLayout>
 <ScrollView android:id="@+id/landlordScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
<LinearLayout android:id="@+id/landlordIntro" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/landlord_intro" android:textColor="@color/text_secondary" android:textSize="14sp" android:layout_marginTop="12dp" />
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardCornerRadius="10dp" app:cardElevation="0dp" app:cardBackgroundColor="#F8F3FC"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/landlord_how_title" android:textColor="@color/text_secondary" android:textSize="14sp" android:layout_marginTop="12dp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/landlord_how" android:textColor="@color/text_secondary" android:textSize="14sp" android:layout_marginTop="12dp" />
</LinearLayout></com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardCornerRadius="10dp" app:cardElevation="0dp" app:cardBackgroundColor="#F8F3FC"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/landlord_insurance_title" android:textColor="@color/text_secondary" android:textSize="14sp" android:layout_marginTop="12dp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/landlord_insurance" android:textColor="@color/text_secondary" android:textSize="14sp" android:layout_marginTop="12dp" />
</LinearLayout></com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardCornerRadius="10dp" app:cardElevation="0dp" app:cardBackgroundColor="#F8F3FC"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/landlord_support_title" android:textColor="@color/text_secondary" android:textSize="14sp" android:layout_marginTop="12dp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/landlord_support" android:textColor="@color/text_secondary" android:textSize="14sp" android:layout_marginTop="12dp" />
</LinearLayout></com.google.android.material.card.MaterialCardView>
</LinearLayout>
<LinearLayout android:id="@+id/landlordAddressPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<com.google.android.material.textfield.TextInputLayout android:id="@+id/landlordAddressBox" style="@style/AuthInput" android:hint="@string/landlord_address_label">
 <com.google.android.material.textfield.TextInputEditText android:id="@+id/landlordAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/landlord_address_hint" android:inputType="textCapSentences" android:maxLength="500" android:maxLines="3"/></com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
<LinearLayout android:id="@+id/landlordInformation" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<com.google.android.material.textfield.TextInputLayout android:id="@+id/landlordYearBox" style="@style/AuthInput" android:hint="@string/landlord_year">
 <com.google.android.material.textfield.TextInputEditText android:id="@+id/landlordYear" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/landlord_year_hint" android:inputType="number" android:maxLength="4" android:maxLines="1"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:id="@+id/landlordBrandBox" style="@style/AuthInput" android:hint="@string/landlord_brand">
 <com.google.android.material.textfield.TextInputEditText android:id="@+id/landlordBrand" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/landlord_brand_hint" android:inputType="textCapWords" android:maxLength="100" android:maxLines="1"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:id="@+id/landlordModelBox" style="@style/AuthInput" android:hint="@string/landlord_model">
 <com.google.android.material.textfield.TextInputEditText android:id="@+id/landlordModel" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/landlord_model" android:inputType="textCapWords" android:maxLength="100" android:maxLines="1"/></com.google.android.material.textfield.TextInputLayout>
<Spinner android:id="@+id/landlordTransmission" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:contentDescription="@string/landlord_transmission" android:spinnerMode="dropdown" />
<com.google.android.material.textfield.TextInputLayout android:id="@+id/landlordMileageBox" style="@style/AuthInput" android:hint="@string/landlord_mileage">
 <com.google.android.material.textfield.TextInputEditText android:id="@+id/landlordMileage" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/landlord_mileage" android:inputType="number" android:maxLength="10" android:maxLines="1"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:id="@+id/landlordDescriptionBox" style="@style/AuthInput" android:hint="@string/landlord_description">
 <com.google.android.material.textfield.TextInputEditText android:id="@+id/landlordDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/landlord_description_hint" android:inputType="textMultiLine|textCapSentences" android:maxLength="4000" android:minLines="4" android:maxLines="8" android:gravity="top"/></com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
<LinearLayout android:id="@+id/landlordPhotosPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/landlord_photo_help" android:textColor="@color/text_secondary" android:textSize="14sp" android:layout_marginTop="12dp" />
<TextView android:id="@+id/landlordPhotoCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:textColor="@color/text_secondary" />
<LinearLayout android:id="@+id/landlordPhotoGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
<com.google.android.material.button.MaterialButton android:id="@+id/landlordGallery" style="@style/AuthOutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="@string/landlord_gallery" />
<com.google.android.material.button.MaterialButton android:id="@+id/landlordCamera" style="@style/AuthOutlinedButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="@string/landlord_camera" />
</LinearLayout>
<LinearLayout android:id="@+id/landlordSuccessPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<ImageView android:layout_width="match_parent" android:layout_height="240dp" android:layout_marginTop="48dp" android:src="@drawable/landlord_success_car" android:scaleType="fitCenter" android:importantForAccessibility="no" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/landlord_success" android:textColor="@color/text_secondary" android:textSize="14sp" android:layout_marginTop="12dp" android:gravity="center" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/landlord_approved" android:textColor="@color/text_secondary" android:textSize="14sp" android:layout_marginTop="12dp" android:gravity="center"/>
</LinearLayout></LinearLayout></ScrollView>
 <ProgressBar android:id="@+id/landlordProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:visibility="gone" />
 <TextView android:id="@+id/landlordError" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B3261E" android:padding="8dp" android:accessibilityLiveRegion="polite" android:visibility="gone" />
 <com.google.android.material.button.MaterialButton android:id="@+id/landlordContinue" android:layout_width="match_parent" android:layout_height="52dp" android:layout_margin="8dp" android:text="@string/landlord_start" />
</LinearLayout>
