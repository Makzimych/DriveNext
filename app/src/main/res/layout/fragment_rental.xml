<!-- ЛР4. Ресурсы аренды, бронирований и избранного. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <com.google.android.material.button.MaterialButton android:layout_width="48dp" android:layout_height="wrap_content" android:id="@+id/rentalBack" android:text="‹" android:minHeight="48dp" style="@style/AuthOutlinedButton" android:textSize="28sp" android:padding="0dp" android:minWidth="0dp" android:contentDescription="@string/lr4_back" />
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:id="@+id/rentalTitle" android:text="" android:textSize="20sp" android:textColor="@color/text_primary" android:padding="8dp" android:layout_weight="1" android:textStyle="bold" />
    <com.google.android.material.button.MaterialButton android:layout_width="56dp" android:layout_height="wrap_content" android:id="@+id/favoriteButton" android:text="" android:minHeight="48dp" style="@style/AuthOutlinedButton" app:icon="@drawable/rental_heart_outline" app:iconGravity="textStart" android:contentDescription="@string/lr4_favorite_add" />
  </LinearLayout>
  <ProgressBar android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/rentalProgress" android:visibility="gone" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/rentalError" android:text="" android:textSize="16sp" android:textColor="@color/text_primary" android:padding="8dp" android:visibility="gone" />
  <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/rentalRetry" android:text="@string/lr4_retry" android:minHeight="48dp" android:visibility="gone" style="@style/AuthOutlinedButton" />
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/rentalScroll" android:fillViewport="true">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/detailsPanel" android:orientation="vertical" android:visibility="gone">
          <ImageView android:layout_width="match_parent" android:layout_height="210dp" android:src="@drawable/catalog_car" android:scaleType="fitCenter" android:importantForAccessibility="no" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/detailsCarName" android:text="" android:textSize="21sp" android:textColor="@color/text_primary" android:padding="8dp" android:textStyle="bold" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/detailsSpecs" android:text="" android:textSize="16sp" android:textColor="@color/text_primary" android:padding="8dp" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/detailsPrice" android:text="" android:textSize="19sp" android:textColor="@color/text_primary" android:padding="8dp" android:textStyle="bold" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/addressLabel" android:text="@string/lr4_address" android:textSize="16sp" android:textColor="@color/text_primary" android:padding="8dp" android:textStyle="bold" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/detailsAddress" android:text="" android:textSize="16sp" android:textColor="@color/text_primary" android:padding="8dp" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/descriptionLabel" android:text="@string/lr4_description" android:textSize="16sp" android:textColor="@color/text_primary" android:padding="8dp" android:textStyle="bold" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/detailsDescription" android:text="" android:textSize="16sp" android:textColor="@color/text_primary" android:padding="8dp" />
          <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/detailsReserve" android:text="@string/lr4_reserve" android:minHeight="48dp" style="@style/Widget.Material3.Button" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/rentPanel" android:orientation="vertical" android:visibility="gone">
          <ImageView android:layout_width="match_parent" android:layout_height="100dp" android:src="@drawable/catalog_car" android:scaleType="fitCenter" android:importantForAccessibility="no" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/rentCarName" android:text="" android:textSize="20sp" android:textColor="@color/text_primary" android:padding="8dp" android:textStyle="bold" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/rentDayPrice" android:text="" android:textSize="16sp" android:textColor="@color/text_primary" android:padding="8dp" />
          <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/rentalStart" android:text="@string/lr4_start" android:minHeight="48dp" style="@style/AuthOutlinedButton" />
          <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/rentalEnd" android:text="@string/lr4_end" android:minHeight="48dp" style="@style/AuthOutlinedButton" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/rentAddress" android:text="" android:textSize="16sp" android:textColor="@color/text_primary" android:padding="8dp" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/rentCost" android:text="" android:textSize="16sp" android:textColor="@color/text_primary" android:padding="8dp" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/rentInsurance" android:text="" android:textSize="16sp" android:textColor="@color/text_primary" android:padding="8dp" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/rentTotal" android:text="" android:textSize="22sp" android:textColor="@color/text_primary" android:padding="8dp" android:textStyle="bold" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/rentDeposit" android:text="" android:textSize="16sp" android:textColor="@color/text_primary" android:padding="8dp" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/rentalDatesError" android:text="@string/lr4_date_error" android:textSize="13sp" android:textColor="@color/text_primary" android:padding="8dp" />
          <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/rentContinue" android:text="@string/lr4_continue" android:minHeight="48dp" style="@style/Widget.Material3.Button" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/successPanel" android:orientation="vertical" android:gravity="center" android:visibility="gone">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/successCheck" android:text="@string/lr4_check" android:textSize="80sp" android:textColor="@color/text_primary" android:padding="8dp" android:gravity="center" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/successMessage" android:text="@string/lr4_success_message" android:textSize="22sp" android:textColor="@color/text_primary" android:padding="8dp" android:textStyle="bold" android:gravity="center" />
          <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/successBookings" android:text="@string/lr4_to_bookings" android:minHeight="48dp" style="@style/AuthOutlinedButton" />
          <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/successHome" android:text="@string/lr4_home" android:minHeight="48dp" style="@style/Widget.Material3.Button" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/bookingPanel" android:orientation="vertical" android:visibility="gone">
          <ImageView android:layout_width="match_parent" android:layout_height="100dp" android:src="@drawable/catalog_car" android:scaleType="fitCenter" android:importantForAccessibility="no" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/bookingCarName" android:text="" android:textSize="20sp" android:textColor="@color/text_primary" android:padding="8dp" android:textStyle="bold" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/bookingDayPrice" android:text="" android:textSize="16sp" android:textColor="@color/text_primary" android:padding="8dp" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/bookingAddress" android:text="" android:textSize="16sp" android:textColor="@color/text_primary" android:padding="8dp" android:textStyle="normal" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/bookingStart" android:text="" android:textSize="16sp" android:textColor="@color/text_primary" android:padding="8dp" android:textStyle="normal" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/bookingEnd" android:text="" android:textSize="16sp" android:textColor="@color/text_primary" android:padding="8dp" android:textStyle="normal" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/bookingDriver" android:text="" android:textSize="16sp" android:textColor="@color/text_primary" android:padding="8dp" android:textStyle="normal" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/bookingLicense" android:text="" android:textSize="16sp" android:textColor="@color/text_primary" android:padding="8dp" android:textStyle="normal" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/bookingStatus" android:text="" android:textSize="16sp" android:textColor="@color/text_primary" android:padding="8dp" android:textStyle="normal" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/bookingCost" android:text="" android:textSize="16sp" android:textColor="@color/text_primary" android:padding="8dp" android:textStyle="normal" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/bookingInsurance" android:text="" android:textSize="16sp" android:textColor="@color/text_primary" android:padding="8dp" android:textStyle="normal" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/bookingTotal" android:text="" android:textSize="22sp" android:textColor="@color/text_primary" android:padding="8dp" android:textStyle="bold" />
          <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/bookingCancel" android:text="@string/lr4_cancel" android:minHeight="48dp" style="@style/Widget.Material3.Button" />
        </LinearLayout>
      </LinearLayout>
    </ScrollView>
    <androidx.recyclerview.widget.RecyclerView android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/rentalList" android:visibility="gone" />
    <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/rentalEmpty" android:text="" android:textSize="16sp" android:textColor="@color/text_primary" android:padding="8dp" android:visibility="gone" android:gravity="center" />
  </FrameLayout>
</LinearLayout>