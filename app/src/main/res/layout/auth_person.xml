<!-- ЛР2. Ресурсы авторизации и регистрации. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><com.google.android.material.textfield.TextInputLayout android:id="@+id/personSurnameBox" style="@style/AuthInput" android:hint="@string/auth_surname" >
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/personSurname" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:maxLines="1"  /></com.google.android.material.textfield.TextInputLayout><com.google.android.material.textfield.TextInputLayout android:id="@+id/personNameBox" style="@style/AuthInput" android:hint="@string/auth_name" >
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/personName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:maxLines="1"  /></com.google.android.material.textfield.TextInputLayout><com.google.android.material.textfield.TextInputLayout android:id="@+id/personPatronymicBox" style="@style/AuthInput" android:hint="@string/auth_patronymic" >
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/personPatronymic" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" android:maxLines="1"  /></com.google.android.material.textfield.TextInputLayout><com.google.android.material.textfield.TextInputLayout android:id="@+id/personBirthdayBox" style="@style/AuthInput" android:hint="@string/auth_birthday" >
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/personBirthday" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:maxLines="1" android:hint="@string/auth_birthday_hint" android:focusable="false" android:clickable="true"/></com.google.android.material.textfield.TextInputLayout><TextView style="@style/AuthText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/auth_gap" android:text="@string/auth_gender"/><RadioGroup android:id="@+id/personGender" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/personMale" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auth_male"/><com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/personFemale" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auth_female"/></RadioGroup><com.google.android.material.button.MaterialButton android:id="@+id/personNext" android:layout_width="match_parent" android:layout_height="@dimen/auth_button_height" android:layout_marginTop="@dimen/auth_gap" android:text="@string/next" /></LinearLayout>
