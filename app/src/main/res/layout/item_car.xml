<!-- ЛР3–4. Каталог, поиск, настройки и общие карточки автомобилей; аренда и избранное. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="20dp" app:strokeWidth="2dp" app:strokeColor="@color/text_primary">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/carName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="21sp" android:textColor="@color/text_primary" android:padding="8dp" android:textStyle="bold" />
        <TextView android:id="@+id/carSpecs" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="13sp" android:textColor="@color/text_primary" android:padding="8dp" />
        <TextView android:id="@+id/carPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="19sp" android:textColor="@color/text_primary" android:padding="8dp" android:textStyle="bold" />
      </LinearLayout>
      <ImageView android:layout_width="125dp" android:layout_height="85dp" android:src="@drawable/catalog_car" android:scaleType="fitCenter" android:importantForAccessibility="no" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
      <com.google.android.material.button.MaterialButton android:id="@+id/carDetails" style="@style/AuthOutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/lr3_cardetails_text" android:layout_weight="1" android:textSize="11sp" />
      <com.google.android.material.button.MaterialButton android:id="@+id/carRent" style="@style/AuthOutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/lr3_carrent_text" android:layout_weight="1" android:textSize="11sp" />
    </LinearLayout>
  </LinearLayout>
</com.google.android.material.card.MaterialCardView>