<!-- ЛР2. Ресурсы авторизации и регистрации. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><com.google.android.material.textfield.TextInputLayout android:id="@+id/accountEmailBox" style="@style/AuthInput" android:hint="@string/auth_email" >
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/accountEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:maxLines="1" android:hint="@string/auth_email_hint" /></com.google.android.material.textfield.TextInputLayout><com.google.android.material.textfield.TextInputLayout android:id="@+id/accountPasswordBox" style="@style/AuthInput" android:hint="@string/auth_password" app:endIconMode="password_toggle">
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/accountPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:saveEnabled="false" android:inputType="textPassword" android:maxLines="1"  /></com.google.android.material.textfield.TextInputLayout><com.google.android.material.textfield.TextInputLayout android:id="@+id/accountRepeatBox" style="@style/AuthInput" android:hint="@string/auth_repeat" app:endIconMode="password_toggle">
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/accountRepeat" android:layout_width="match_parent" android:layout_height="wrap_content" android:saveEnabled="false" android:inputType="textPassword" android:maxLines="1"  /></com.google.android.material.textfield.TextInputLayout><com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/accountTerms" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/auth_gap" android:text="@string/auth_terms"/><com.google.android.material.button.MaterialButton android:id="@+id/accountPolicy" style="@style/AuthOutlinedButton" android:layout_width="match_parent" android:layout_height="@dimen/auth_button_height" android:layout_marginTop="@dimen/auth_gap" android:text="@string/auth_terms_title" /><com.google.android.material.button.MaterialButton android:id="@+id/accountNext" android:layout_width="match_parent" android:layout_height="@dimen/auth_button_height" android:layout_marginTop="@dimen/auth_gap" android:text="@string/next" /></LinearLayout>
